{
    "AWSTemplateFormatVersion": "2010-09-09",
    "Parameters" : {
        "ANumberParameter" : {
            "Type" : "String",
            "Default" : "a123456",
            "Description" : "Enter your ANumber:"
        },
        "BucketNameParameter" : {
          "Type" : "String",
          "Default" : "a123456-bucket",
          "Description" : "Enter Desired Bucket Name:"
        },
        "TableNameParameter" : {
            "Type" : "String",
            "Default" : "a123456-table",
            "Description" : "Enter Desired DynamoDB Table Name:"
        },
        "KeyNameParameter" : {
            "Type" : "AWS::EC2::KeyPair::KeyName",
            "Default" : "a123456",
            "Description" : "Select your SSH Key:"
        },
        "UserNameParameter" : {
            "Type" : "String",
            "Default" : "a123456-user2",
            "Description" : "Enter the IAM Username to create:"
        }
    },
    "Resources": {
        "MyBucket": {
            "Type": "AWS::S3::Bucket",
            "Properties": {
                "BucketName": {"Ref" : "BucketNameParameter"}
            }
        },
        "MyEC2Instance" : {
            "Type" : "AWS::EC2::Instance",
            "Properties" : {
                "ImageId" : "ami-066784287e358dad1",
                "KeyName" :  {"Ref" : "KeyNameParameter"},
                "InstanceType" : "t2.micro",
                "BlockDeviceMappings" : [
                    {
                      "DeviceName" : "/dev/sdm",
                      "Ebs" : {
                           "VolumeType" : "gp3",
                           "DeleteOnTermination" : "true",
                           "VolumeSize" : "25"
                         }
                       }, 
                       {
                         "DeviceName" : "/dev/sdk",
                         "NoDevice" : {}
                       }
                   ]
                }
            },
        "MyEC2WindowsInstance" : {
            "Type" : "AWS::EC2::Instance",
            "Properties" : {
                "ImageId" : "ami-07cc1bbe145f35b58",
                "KeyName" :  {"Ref" : "KeyNameParameter"},
                "InstanceType" : "t2.small",
                "BlockDeviceMappings" : [
                    {
                        "DeviceName" : "/dev/sdm",
                        "Ebs" : {
                            "VolumeType" : "gp3",
                            "DeleteOnTermination" : "true",
                            "VolumeSize" : "30"
                            }
                        }, 
                        {
                            "DeviceName" : "/dev/sdk",
                            "NoDevice" : {}
                        }
                    ]
                }
            },
        "MyNewUser" : {
            "Type" : "AWS::IAM::User",
            "Properties" : {
                "UserName" : { "Fn::Join" : [ "-", [ {"Ref" : "ANumberParameter"},"userid"]]
                }
            }
        }
    }
}
